# Reference syntax: Squat / 3x5 100kg / 120s           (rest)
#              Plank / 3x1 60s|30s               (work then rest)
#              Power Clean / 5x5 60kg 60s|0s auto (EMOM)
#              Squat, Bodyweight / 8x1+ 20s|10s auto (Tabata)
#              Dead Hang / 1x1 30s+|60s           (count up past 30s)
program("Timers", weeks=2)
day(1, 1, "Conditioning", weeks="1-2", kind="conditioning")
ex("Squat", warmup=[], sets=[s(3, 5, kg(100), rest=120)])
ex("Plank", sets=[s(3, 1, bw(), work=60, rest=30)])
ex("Power Clean", warmup=[], sets=[s(5, 5, kg(60), work=60, rest=0, auto=True)])
ex("Squat, Bodyweight", sets=[s(8, 1, bw(), amrap=True, work=20, rest=10, auto=True)])
ex("Dead Hang", sets=[s(1, 1, bw(), work=30, count_up=True, rest=60)])
