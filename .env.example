# Copy to .env next to docker-compose.yaml, or set these in the Portainer stack. Every value is
# optional except POSTGRES_PASSWORD.

# Postgres password, used by both services. Set it before the first start; it cannot be changed
# through compose later.
POSTGRES_PASSWORD=

# Host directory holding everything: .postgres/ (database) and exercises/ (catalog images).
DATA_ROOT=./data

# Owner of DATA_ROOT/exercises; 0 is root, which can always write there.
PUID=0
PGID=0

# Host port the server is published on.
LISTEN_PORT=8080

# Address clients use, such as https://lift.example.com. Empty keeps links relative.
PUBLIC_URL=

# invite (every account after the first needs an invite code) or open.
REGISTRATION=invite

# Extra browser origins allowed to call the API with cookies, comma-separated.
ALLOWED_ORIGINS=

# auto loads the catalog shipped in the image when its version is new; off never touches it.
SEED_CATALOG=auto

# Image to run; a tag pins a version.
PLUSULTRA_IMAGE=gdsoumya/plusultra:latest

# Postgres shared_buffers; modest for a NAS.
POSTGRES_SHARED_BUFFERS=256MB

# Full Postgres URL, when the database is not the postgres service of this stack.
DATABASE_URL=

# Development only (docker-compose.override.yaml): host port of Postgres and the build version.
PG_PORT=5433
VERSION=dev
